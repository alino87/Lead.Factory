# -------------------------------------------------------
# LeadFactory – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach ".env" und trage deine Werte ein
# -------------------------------------------------------

# Anthropic API-Schlüssel (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# API-Schlüssel für diesen Server (frei wählbar, mindestens 32 Zeichen)
# PFLICHTFELD: Server startet nicht wenn dieser Key fehlt
API_FACTORY_KEY=mein-geheimer-schluessel-hier

# Optionale Konfiguration
# UNTERNEHMENSNAME=Musterfirma GmbH          (für Briefanalyse-Kontext)
# DATABASE_URL=sqlite:///./leadfactory.db    (Standard: SQLite lokal)
# SCAN_EINGANG=./Scanner-Eingang
# ARCHIV_ORDNER=./Archiv

# -------------------------------------------------------
# MALIN – Docker Compose Konfiguration
# -------------------------------------------------------
# POSTGRES_PASSWORD=malin_dev
# MASTER_TENANT_KEY=dev-tenant-key-change-me
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_BUCKET=malin-documents
